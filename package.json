{
  "name": "passkey-e2e",
  "private": true,
  "description": "E2E passkey register/sign-in via a Playwright virtual authenticator",
  "scripts": {
    "auth": "playwright codegen --save-storage=auth.json ${APP_BASE_URL:-http://localhost:3000}/sign_in",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
